{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../../../",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": false,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": false
  },
  "include": ["./**.ts", "../../../src/types/**/*.ts"],
  "exclude": ["./dist", "../../../node_modules"]
}

